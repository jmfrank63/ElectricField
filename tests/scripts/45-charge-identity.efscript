# 45-charge-identity: per-charge id/name/size through the API, the state oracle and the collection file (v2.6 phase 3)
collection.open Original
tab.new-empty
app.wait-done
charge.name 0 "My Charge"
charge.size 0 40
app.expect charges=1,0,0,40,1,My Charge
charge.add -2 3 0
# IN-01: charge.add freezes the Options default (25 in a fresh sandbox) exactly like the GUI add sites.
app.expect ";-2,3,0,25,2,Charge 2"
charge.remove 1
charge.add -2 3 0
app.expect ";-2,3,0,25,3,Charge 2"
# add/remove are not undoable (v2.5 history model): the undo restores the pre-size-edit snapshot,
# which carries name + size + id of the surviving charge through the ChargeSystem snapshot.
editor.undo
app.expect charges=1,0,0,0,1,My Charge
# IN-05: the size is re-applied BEFORE the save so the collection file round-trip pins a NON-ZERO
# sizePx on disk (the undo-only flow used to save size 0 and the file path went untested for 40).
charge.size 0 40
# 261020-ef2: the minimum size allowed for a charge is 1; 0.5 and 121 are refused.
charge.size 0 1
app.expect charges=1,0,0,1,1,My Charge
app.expect-error "0 or 1-120" charge.size 0 0.5
app.expect-error "0 or 1-120" charge.size 0 121
charge.size 0 40
# 261020-ef2: the optional value-and-size coupling - a resize sets the charge's value to the size.
app.expect couple=0
app.expect-error "on|off" options.set couple-value-size maybe
options.set couple-value-size on
app.expect couple=1
charge.size 0 12
app.expect charges=12,0,0,12,1,My Charge
options.set couple-value-size off
app.expect couple=0
charge.size 0 40
app.expect charges=12,0,0,40,1,My Charge  # uncoupled resize: the value stays 12
# restore the original value through charge.value - 0 is refused (261020-ef2), 1 applies.
app.expect-error "must not be 0" charge.value 0 0
charge.value 0 1
config.save-as "Identity Test"
tab.close
config.open "Identity Test"
app.wait-done
app.expect charges=1,0,0,40,1,My Charge
app.quit force